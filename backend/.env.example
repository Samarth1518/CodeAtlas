# Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control or expose secret tokens.

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# GitHub API token
# Generate a Personal Access Token at: https://github.com/settings/tokens
# Raises rate limit from 60 to 5000 requests/hour for public repos.
GITHUB_TOKEN=your_github_token_here

# LLM Provider Configuration for RAG (Phase 6)
# Supports Gemini / OpenAI / OpenRouter / Anthropic or any standard OpenAI-compatible API.
# Leave empty or set a key to enable live LLM grounded answers.
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash
# Optional: custom base URL (e.g., https://generativelanguage.googleapis.com/v1beta/openai or https://api.openai.com/v1)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
